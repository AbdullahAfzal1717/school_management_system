// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?

  announcements    Announcement[] @relation("AnnouncementAuthor")
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")

  @@index([role])
}

model TeacherProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  employeeId String   @unique
  phone      String?
  address    String?
  photoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  teachingAssignments TeachingAssignment[]
  supervisedClasses   SchoolClass[]        @relation("ClassSupervisor")
  lessons             Lesson[]
  exams               Exam[]
  assignments         Assignment[]
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  studentNumber String   @unique
  phone         String?
  address       String?
  photoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  guardians   ParentStudent[]
  examResults ExamResult[]
  attendances Attendance[]
}

model ParentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  address   String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  children ParentStudent[]
}

model AcademicYear {
  id                  String               @id @default(cuid())
  name                String               @unique
  startDate           DateTime
  endDate             DateTime
  isCurrent           Boolean              @default(false)
  classes             SchoolClass[]
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
}

model SchoolClass {
  id             String  @id @default(cuid())
  name           String
  grade          Int
  capacity       Int
  academicYearId String
  supervisorId   String?

  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  supervisor          TeacherProfile?      @relation("ClassSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  enrollments         Enrollment[]
  teachingAssignments TeachingAssignment[]
  lessons             Lesson[]
  exams               Exam[]
  assignments         Assignment[]
  attendances         Attendance[]
  events              Event[]
  announcements       Announcement[]

  @@unique([name, academicYearId])
  @@index([academicYearId])
}

model Subject {
  id                  String               @id @default(cuid())
  name                String               @unique
  teachingAssignments TeachingAssignment[]
  lessons             Lesson[]
  exams               Exam[]
  assignments         Assignment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Enrollment {
  id             String   @id @default(cuid())
  studentId      String
  schoolClassId  String
  academicYearId String
  enrolledAt     DateTime @default(now())

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass    @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolClassId])
}

model ParentStudent {
  parentId     String
  studentId    String
  relationship String?

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model TeachingAssignment {
  id             String @id @default(cuid())
  teacherId      String
  subjectId      String
  schoolClassId  String
  academicYearId String

  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  schoolClass  SchoolClass    @relation(fields: [schoolClassId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, schoolClassId, academicYearId])
  @@index([schoolClassId, academicYearId])
}

model Lesson {
  id        String   @id @default(cuid())
  name      String
  day       Weekday
  startTime String
  endTime   String
  subjectId String
  classId   String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
}

model Exam {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  startTime String
  endTime   String
  subjectId String
  classId   String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  results ExamResult[]

  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
}

model ExamResult {
  id        String   @id @default(cuid())
  score     Int
  examId    String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId])
  @@index([studentId])
}

model Assignment {
  id        String   @id @default(cuid())
  title     String
  startDate DateTime
  dueDate   DateTime
  subjectId String
  classId   String
  teacherId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([classId])
  @@index([teacherId])
}

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus
  studentId String
  classId   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([classId])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  startTime   String
  endTime     String
  classId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([classId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  date      DateTime
  classId   String?
  authorId  String?
  createdAt DateTime @default(now())

  class  SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  author User?        @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([classId])
  @@index([authorId])
  @@index([date])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  subject    String
  body       String
  sentAt     DateTime @default(now())
  read       Boolean  @default(false)

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}
